  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "Read the interleaving policy a site declared: maxDetourM (the farthest a candidate may lie from the station), maxCandidates (1..5), hintTtlSeconds, eligibleTaskTypes, verticalWeight, version and declaredAt. A site that never declared a policy is inert (no hint is ever issued for it) and fails with policy-not-found. Read-only; a malformed site fails with invalid-site-id.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "siteId": {
          "description": "the site whose interleaving policy to read, e.g. SITE-1",
          "type": "string"
        }
      },
      "required": [
        "siteId"
      ],
      "type": "object"
    },
    "name": "get_site_policy",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "declaredAt": {
          "type": "string"
        },
        "eligibleTaskTypes": {
          "items": {
            "type": "string"
          },
          "type": [
            "null",
            "array"
          ]
        },
        "hintTtlSeconds": {
          "type": "integer"
        },
        "maxCandidates": {
          "type": "integer"
        },
        "maxDetourM": {
          "type": "number"
        },
        "siteId": {
          "type": "string"
        },
        "version": {
          "type": "integer"
        },
        "verticalWeight": {
          "type": "number"
        }
      },
      "required": [
        "siteId",
        "maxDetourM",
        "maxCandidates",
        "hintTtlSeconds",
        "eligibleTaskTypes",
        "verticalWeight",
        "version",
        "declaredAt"
      ],
      "type": "object"
    }
  },
