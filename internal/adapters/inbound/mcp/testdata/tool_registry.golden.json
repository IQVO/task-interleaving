  {
    "annotations": {
      "idempotentHint": true,
      "openWorldHint": false,
      "readOnlyHint": true
    },
    "description": "List interleaving hints newest first, a page at a time, optionally only those issued to one station (stationId), of one site (siteId) and/or in one state (Active, Consumed, Expired or Superseded). Each hint carries its ranked candidates (rank, taskId, taskType, location, detourM) and how it ended. Pass the returned nextCursor to get the next page; it is absent on the last page. Read-only; a bad limit fails with invalid-limit, a bad cursor with invalid-cursor, an unknown state with invalid-state and a malformed station or site with invalid-station-id or invalid-site-id.",
    "inputSchema": {
      "additionalProperties": false,
      "properties": {
        "cursor": {
          "description": "the opaque nextCursor returned by the previous page; omitted means the first page",
          "type": "string"
        },
        "limit": {
          "description": "page size, 1..500; omitted or 0 means the default page size",
          "type": "integer"
        },
        "siteId": {
          "description": "keep only hints of this site; omitted means every site",
          "type": "string"
        },
        "state": {
          "description": "keep only hints in this state: Active, Consumed, Expired or Superseded",
          "type": "string"
        },
        "stationId": {
          "description": "keep only hints issued to this station; omitted means every station",
          "type": "string"
        }
      },
      "type": "object"
    },
    "name": "list_hints",
    "outputSchema": {
      "additionalProperties": false,
      "properties": {
        "items": {
          "items": {
            "additionalProperties": false,
            "properties": {
