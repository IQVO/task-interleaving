                    "taskType",
                    "location",
                    "detourM"
                  ],
                  "type": "object"
                },
                "type": [
                  "null",
                  "array"
                ]
              },
              "consumedAt": {
                "type": "string"
              },
              "consumedTaskId": {
                "type": "string"
              },
              "expiresAt": {
                "type": "string"
              },
              "hintId": {
                "type": "string"
              },
              "issuedAt": {
                "type": "string"
              },
              "originLocation": {
                "type": "string"
              },
              "policyVersion": {
                "type": "integer"
              },
              "siteId": {
                "type": "string"
              },
              "state": {
                "type": "string"
              },
              "stationId": {
                "type": "string"
              },
              "supersededAt": {
                "type": "string"
              },
              "version": {
                "type": "integer"
              }
            },
            "required": [
              "hintId",
              "stationId",
              "siteId",
              "state",
              "afterTaskId",
              "originLocation",
              "issuedAt",
              "expiresAt",
              "policyVersion",
              "candidates",
              "version"
            ],
            "type": "object"
          },
          "type": [
